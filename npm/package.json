{
  "name": "@midmanstudio/mid-qr",
  "version": "0.0.1",
  "description": "Unified QR code generation and scanning — Rust/WASM core, custom dot styles, gradients, logos, frames.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [ "dist", "wasm", "worker", "README.md", "LICENSE" ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types":  "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build:wasm":   "wasm-pack build ../crates/mid-qr-wasm --target web --out-dir ../npm/wasm",
    "build:ts":     "tsc && rollup -c",
    "build:worker": "mkdir -p worker && cp src/worker/qr-scanner.min.js src/worker/qr-scanner-worker.min.js worker/",
    "build":        "npm run build:wasm && npm run build:ts && npm run build:worker",
    "prepublishOnly": "npm run build",
    "test":         "vitest run"
  },
  "keywords": [
    "qr", "qrcode", "wasm", "webassembly", "rust",
    "scanner", "generator", "mid-qr", "midmanstudio"
  ],
  "author": "MidManStudio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url":  "https://github.com/MidManStudio/mid_qr_code_lib.git"
  },
  "homepage": "https://midmanstudio.github.io/mid_qr_code_lib/",
  "bugs": {
    "url": "https://github.com/MidManStudio/mid_qr_code_lib/issues"
  },
  "devDependencies": {
    "typescript":                "^5.0.0",
    "tslib":                     "^2.6.0",
    "rollup":                    "^4.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "vitest":                    "^1.0.0"
  }
}
